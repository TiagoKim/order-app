{
  "name": "cozy-coffee-order-app",
  "version": "1.0.0",
  "description": "COZY 커피 주문 앱 - 풀스택 애플리케이션",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"cd server && npm run dev\" \"cd ui && npm run dev\"",
    "build": "cd ui && npm run build",
    "install-all": "cd server && npm install && cd ../ui && npm install",
    "render-postbuild": "cd server && npm install",
    "render-start": "node server.js"
  },
  "keywords": [
    "coffee",
    "order",
    "react",
    "express",
    "postgresql"
  ],
  "author": "COZY Team",
  "license": "ISC",
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
